# Cloudflare static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Hashed build output never changes under its name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Datasets are fetched as `<file>.gz?v=<sha256>`, so a new build changes their URL; a day of
# caching covers repeat visits without pinning anything for long.
/data/*
  Cache-Control: public, max-age=86400

/data/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
